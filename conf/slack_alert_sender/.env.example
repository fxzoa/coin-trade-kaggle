# .env.example - Copy to .env and fill in your values
# Slack API Configuration
SLACK_BOT_TOKEN=
NOTIFICATIONS_ENABLED=

# Redis Configuration
REDIS_URL=
# or separate options:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_QUEUE_KEY=

# Slack Channel IDs (Overrides DEFAULT_CHANNELS)
SLACK_CHANNEL_NOTIFY=
SLACK_CHANNEL_ERROR=
SLACK_CHANNEL_BUY=
SLACK_CHANNEL_SELL=
SLACK_CHANNEL_CLOSE_PLUS=
SLACK_CHANNEL_CLOSE_MINUS=
SLACK_CHANNEL_ORD_OPEN=
SLACK_CHANNEL_ORD_TP=

# History Database Path & Retention
HISTORY_DB_PATH=
HISTORY_RETENTION_DAYS=

# Logging
LOG_LEVEL=
