# .env.example - Copy to .env and fill in your values
# surge-dip-bot 環境設定

# =====================================================================
# Hyperliquid 接続 & 取引設定
# =====================================================================
HY_WALLET_ADDRESS=
HY_SECRET_KEY=
HY_API_URL=
HY_IS_MAINNET=

# 自動発注スイッチ (true で自動発注、false でドライラン)
AUTO_ORDER_ENABLED=
# 1注文あたりのデフォルト発注額 (USD)
DEFAULT_ORDER_SIZE_USD=
# 利確目標ゲイン率 (%)
TAKE_PROFIT_GAIN_PCT=

# =====================================================================
# データストア設定 (Redis / Deno KV)
# =====================================================================
REDIS_URL=
REDIS_STORE_PREFIX=
CANDLE_STORE=
KV_PATH=

# =====================================================================
# 通知 & ロギング
# =====================================================================
LOG_LEVEL=
REDIS_QUEUE_KEY=
SLACK_QUEUE_KEY=
