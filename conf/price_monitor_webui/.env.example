# ==========================================
# Web UI & API Server Configuration
# ==========================================
PORT=8005
WEB_PORT=8005

# ==========================================
# Redis Settings
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=hl:

# Optional: Default Hyperliquid wallet address to display
HL_USER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Local SQLite Deno KV fallback path
KV_PATH=./data/kv.sqlite

# Optional: Slack error notification queue
REDIS_QUEUE_KEY=slack:alert:queue
