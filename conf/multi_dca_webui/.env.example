# ========================================================
# multi-dca-webui 環境変数設定 (テンプレート)
# ========================================================

PORT=8008
LOG_LEVEL=INFO

# データベース・イベント連携 (Redis & Deno KV)
REDIS_URL=redis://localhost:6379
REDIS_STORE_PREFIX=hl:dca:
REDIS_KEY_PREFIX=hl:
BOT_ENABLED_KEY=hl:dca:enabled
KV_PATH=./data/kv.sqlite

# Slack エラー通知キュー
REDIS_QUEUE_KEY=slack:alert:queue
