# .env.example - Copy to .env and fill in your values
# Hyperliquid API 認証情報 (Bot実行のみに必要)
HY_WALLET_ADDRESS=
HY_SECRET_KEY=
SLACK_WEBHOOK_URL=

# 取引および動作設定
LOG_LEVEL=
TARGET_COINS=
DEFAULT_ORDER_SIZE_USD=
AUTO_ORDER_ENABLED=
SCAN_INTERVAL_SEC=

# Redis & KV 設定
REDIS_URL=
REDIS_STORE_PREFIX=
KV_PATH=

# ========================================================
# DCA 期間別シグナル判定閾値 (単位: %)
# ========================================================
# LONG (押し目買い・高値からの下落率)
DIP_THRESHOLD_24H=
DIP_THRESHOLD_7D=
DIP_THRESHOLD_30D=
DIP_THRESHOLD_90D=
DIP_THRESHOLD_180D=
DIP_THRESHOLD_360D=
ADDITIONAL_DIP_THRESHOLD_24H=

# SHORT (戻り売り・最安値からの急騰率)
SURGE_THRESHOLD_24H=
SURGE_THRESHOLD_7D=
SURGE_THRESHOLD_30D=
SURGE_THRESHOLD_90D=
SURGE_THRESHOLD_180D=
SURGE_THRESHOLD_360D=

ADDITIONAL_SURGE_THRESHOLD_24H=

# --- 新規オーダーは Redis トピックへ PUBLISH し、coin-trade-bot が Hyperliquid へ発注 ---
REDIS_ORDER_CHANNEL=hl:events:orders:new
REDIS_ORDER_RESULT_CHANNEL=hl:events:orders:result
# 注文データに付与する BOT ID (複数インスタンス運用時の識別用)
BOT_ID=btc-dca-bot
# true で自前TP決済も有効化 (既定 false: 利確は coin-trade-bot に委譲)
SELF_TP_ENABLED=false
