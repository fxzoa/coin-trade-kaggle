# ==========================================
# Hyperliquid WebSocket & REST Settings
# ==========================================
# Mainnet WebSocket URL
HL_WS_URL=wss://api.hyperliquid.xyz/ws
# Mainnet Info API URL
HL_INFO_URL=https://api.hyperliquid.xyz/info

# User wallet address for Order and Position tracking (Optional)
# If empty, only market allMids price stream will be subscribed.
HL_USER_ADDRESS=0x0000000000000000000000000000000000000000

# Filter coins (comma separated, e.g. BTC,ETH,SOL). Leave blank to subscribe to all.
HL_TARGET_COINS=

# Include prediction / outcome markets
HL_INCLUDE_OUTCOMES=false

# ==========================================
# Redis Settings
# ==========================================
REDIS_URL=redis://localhost:6379
# Key prefix for all stored keys in Redis
REDIS_KEY_PREFIX=hl:

# ==========================================
# Local Persistence & Error Alert Settings
# ==========================================
KV_PATH=./data/kv.sqlite
REDIS_QUEUE_KEY=slack:alert:queue
