# ========================================================
# multi-dca-bot 環境変数設定 (テンプレート)
# ========================================================

# Hyperliquid API 認証情報
HY_WALLET_ADDRESS=0xYourWalletAddressHere
HY_SECRET_KEY=0xYourPrivateKeyOrApiAgentKeyHere
HY_IS_MAINNET=true

# 通知設定 (Slack Alert Queue)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
REDIS_QUEUE_KEY=slack:alert:queue

# データベース・永続化設定
REDIS_URL=redis://localhost:6379
REDIS_STORE_PREFIX=hl:dca:
REDIS_KEY_PREFIX=hl:
KV_PATH=./data/kv.sqlite
LOG_LEVEL=INFO

# 取引・スキャン設定
TARGET_COINS=BTC,ETH,SOL,HYPE,ENA,NEAR,AAVE,LINK
DEFAULT_ORDER_SIZE_USD=1000
AUTO_ORDER_ENABLED=true
SCAN_INTERVAL_SEC=300

# ========================================================
# DCA 期間別シグナル判定閾値 (単位: %)
# ========================================================
# LONG (押し目買い・期間高値からの下落率)
DIP_THRESHOLD_24H=16.18
DIP_THRESHOLD_7D=26.18
DIP_THRESHOLD_30D=36.18
DIP_THRESHOLD_90D=46.18
DIP_THRESHOLD_180D=56.18
DIP_THRESHOLD_360D=66.18
ADDITIONAL_DIP_THRESHOLD_24H=3.82

# SHORT (戻り売り・期間安値からの急騰率)
SURGE_THRESHOLD_24H=16.18
SURGE_THRESHOLD_7D=38.2
SURGE_THRESHOLD_30D=61.8
SURGE_THRESHOLD_90D=100.0
SURGE_THRESHOLD_180D=138.2
SURGE_THRESHOLD_360D=161.8
ADDITIONAL_SURGE_THRESHOLD_24H=3.82

# 利確 (Take-Profit: 期間安値からの反発率)
TP_THRESHOLD_30D=26.18
TP_THRESHOLD_90D=36.18
TP_THRESHOLD_180D=46.18
TP_THRESHOLD_360D=56.18

# --- 新規オーダーは Redis トピックへ PUBLISH し、coin-trade-bot が Hyperliquid へ発注 ---
REDIS_ORDER_CHANNEL=hl:events:orders:new
REDIS_ORDER_RESULT_CHANNEL=hl:events:orders:result
# 注文データに付与する BOT ID (複数インスタンス運用時の識別用)
BOT_ID=multi-dca-bot
