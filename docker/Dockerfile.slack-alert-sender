FROM denoland/deno:alpine-2.9.5

WORKDIR /app

ENV DENO_DIR=/app/.cache/deno

COPY deno.json ./
COPY src/ ./src/

RUN mkdir -p /app/data /app/.cache/deno && \
    deno cache --unstable-kv --allow-import src/slack_alert_sender/worker/main.ts && \
    chown -R deno:deno /app

USER deno

CMD ["run", "--allow-net", "--allow-env", "--allow-read", "--allow-write", "--allow-ffi", "src/slack_alert_sender/worker/main.ts"]
