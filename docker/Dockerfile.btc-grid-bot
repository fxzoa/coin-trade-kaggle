FROM denoland/deno:alpine-2.9.5

WORKDIR /app

ENV DENO_DIR=/app/.cache/deno

COPY deno.json ./
COPY src/ ./src/

RUN mkdir -p /app/data /app/.cache/deno && \
    deno cache --unstable-kv --allow-import src/btc_grid_bot/worker/main.ts && \
    chown -R deno:deno /app

USER deno

CMD ["run", "--unstable-kv", "--allow-net", "--allow-read", "--allow-write", "--allow-env", "src/btc_grid_bot/worker/main.ts"]
