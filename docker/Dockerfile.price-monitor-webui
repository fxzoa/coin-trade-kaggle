FROM denoland/deno:alpine-2.9.5

WORKDIR /app

ENV DENO_DIR=/app/.cache/deno
ENV PORT=8005

# 依存関係キャッシュの最適化
COPY deno.json ./
COPY src/ ./src/

# 事前キャッシュとデータディレクトリ権限付与
RUN mkdir -p /app/data /app/.cache/deno && \
    deno cache --unstable-kv --allow-import src/price_monitor_webui/server.ts && \
    chown -R deno:deno /app

USER deno

EXPOSE 8005

CMD ["run", "--unstable-kv", "--allow-net", "--allow-read", "--allow-write", "--allow-env", "src/price_monitor_webui/server.ts"]
