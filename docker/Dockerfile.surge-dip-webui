FROM denoland/deno:alpine-2.9.5

WORKDIR /app

ENV DENO_DIR=/app/.cache/deno
ENV PORT=8004

COPY deno.json ./
COPY src/ ./src/

RUN mkdir -p /app/data /app/.cache/deno && \
    deno cache --unstable-kv --allow-import src/surge_dip_webui/webui/main.ts && \
    chown -R deno:deno /app

USER deno

EXPOSE 8004

CMD ["run", "--allow-net", "--allow-read", "--allow-env", "src/surge_dip_webui/webui/main.ts"]
